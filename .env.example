# ─────────────────────────────────────────────────────────────
#  Catálogo de Referências — variáveis de ambiente
#  Copie para `.env` (local) ou configure no seu host (Railway etc.).
#  TODAS são opcionais: sem nada, o app roda como catálogo local editável.
# ─────────────────────────────────────────────────────────────

# Senha de edição no DEPLOY. Sem ela, o site publicado é somente-leitura.
# No servidor LOCAL a edição é sempre livre (não precisa de senha).
EDIT_TOKEN=

# Chave do Google Gemini — necessária para ADICIONAR referências por
# URL, imagem/print ou (com Cobalt) carrossel/vídeo. Pegue em
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Opcional) Instância self-hosted do Cobalt (github.com/imputnet/cobalt),
# usada para ler links de rede social (carrossel inteiro + áudio/frames de vídeo).
# Ex.: rede privada do Railway -> http://cobalt.railway.internal:9000
COBALT_API=
COBALT_KEY=

# (Opcional) MODO ESPELHO: publica um deploy SOMENTE-LEITURA que lê os dados
# de outro deploy em tempo real. Defina com a URL do deploy "original".
# Ao definir MIRROR_URL, o modo read-only liga automaticamente.
MIRROR_URL=

# (Opcional) Força somente-leitura sem espelhar (1 = liga).
READ_ONLY=

# (Opcional) URL do seu deploy, para o sync local -> deploy (botões ↑/↓).
DEPLOY_URL=

# (Opcional) Diretório de dados. No Railway aponte para um Volume (ex.: /data)
# para o refs-data.js persistir entre deploys.
DATA_DIR=

# PORT é definido automaticamente pela plataforma (Railway). Local usa 4177.
# PORT=
